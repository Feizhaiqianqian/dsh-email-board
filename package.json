{
  "name": "dsh-email-board",
  "version": "0.1.0",
  "description": "DSH 邮件看板：把 dsh-email 各账号的未读邮件按账号汇总成卡片列表，手动刷新并展示在右侧栏的自定义 tab 里。Unread-mail board for DeepSeek Harness.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "email",
    "dashboard",
    "unread"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "author": "Feizhaiqianqian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Feizhaiqianqian/dsh-email-board.git"
  },
  "homepage": "https://github.com/Feizhaiqianqian/dsh-email-board#readme",
  "bugs": {
    "url": "https://github.com/Feizhaiqianqian/dsh-email-board/issues"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node test/render-board.mjs",
    "test:host": "node test/offline-route.mjs"
  },
  "license": "MIT"
}
